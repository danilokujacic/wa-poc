entity_changes=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.entity\.ts$')

if [ -z "$entity_changes" ]; then
  exit 0
fi

echo "Entity files changed, checking for a missing migration..."
echo "$entity_changes"

pnpm exec typeorm-ts-node-commonjs -d src/data-source.ts migration:generate src/migrations/check --check
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "Migration check failed (exit $status)."
  echo "If this is a real schema change, run: pnpm run migration:generate"
  echo "then commit the generated file alongside your entity change."
  echo "If this failed to connect to a database, start it first: docker compose up -d postgres"
  exit 1
fi
