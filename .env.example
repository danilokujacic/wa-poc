PORT=3002
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
GEMINY_API_KEY=
GROQ_API_KEY=
# Active AI client as of the Hugging Face migration — see src/ai/ai.module.ts.
# Get a token at https://huggingface.co/settings/tokens. HF_MODEL and
# HF_BASE_URL are both optional; default to meta-llama/Llama-3.1-8B-Instruct
# via HF's Inference Providers router (https://router.huggingface.co/v1) —
# verify that model ID is still current at https://huggingface.co/models
# before relying on the default in production.
HF_API_KEY=
HF_MODEL=
HF_BASE_URL=

# Local dev: leave as-is (docker-compose's `postgres` service). Production:
# point these at your Neon connection string's pieces (host/port/user/pass/
# database from Neon's dashboard) and set DB_SSL=true — Neon requires SSL,
# local Postgres doesn't have it configured. See docker-compose.yml's `app`
# service comment: `postgres` is deliberately NOT started in production
# anymore now that the database is Neon, not a local container.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=wa_poc
DB_SSL=false

# S3-compatible object storage for resort-feature images (see
# src/storage/storage.service.ts) — works unchanged against Cloudflare R2
# (recommended: zero egress fees), self-hosted Minio, Backblaze B2, or AWS
# S3; only these values differ per provider.
# R2: S3_ENDPOINT is https://<account_id>.r2.cloudflarestorage.com,
# S3_REGION is "auto", S3_PUBLIC_URL_BASE is your R2 public bucket URL or
# custom domain.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

JWT_SECRET=
JWT_EXPIRES_IN=1d
REDIS_HOST=localhost
REDIS_PORT=6379
APP_NAME=wa-poc
LOKI_HOST=http://localhost:3100
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_KEY=
SMTP_FROM="wa-poc <no-reply@wa-poc.example.com>"
APP_BASE_URL=http://localhost:3002
EMAIL_CONFIRMATION_EXPIRY_HOURS=24
ADMIN_EMAIL=
FRONTEND_URL=http://localhost:3000
CHANNEX_API_KEY=
CHANNEX_API_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_WEBHOOK_TOKEN=
SESSION_MESSAGE_LIMIT=15

# Set NODE_ENV=production and uncomment to also bring up loki/grafana/app_blue/
# app_green via `docker compose up -d` (all skipped by default in development —
# local dev just runs `docker compose up -d postgres redis maildev` plus
# `pnpm start:dev`). deploy.sh sets this itself; you only need it if running
# compose commands by hand.
# COMPOSE_PROFILES=production

# Hetzner production only — app_blue/app_green in docker-compose.yml, fronted
# by nginx on the host (see infra/nginx/app.conf). Fixed host ports for
# nginx's upstream pool; only change if something else on the host already
# uses 3002/3003. RELEASES_DIR is where deploy.sh extracts each build
# (dist/node_modules/package.json) — defaults to a "releases" folder next to
# the repo checkout, needs no VPS setup. Only set this if you want releases
# to live somewhere that survives a full re-clone of the repo (then you must
# create that directory yourself, writable by whatever user runs deploy.sh).
# APP_PORT_BLUE=3002
# APP_PORT_GREEN=3003
# RELEASES_DIR=/opt/wa-poc/releases

# --- Hetzner VPS deploy credentials -----------------------------------------
# NOT read by the app itself — nothing in this codebase consumes these. They
# exist here only as a checklist of what deploy.sh needs, which must actually
# be added as GitHub Actions repo secrets (Settings -> Secrets and variables
# -> Actions), using these exact secret names, for .github/workflows/deploy.yml
# to be able to SSH into the VPS and run scripts/deploy.sh:
#   DEPLOY_HOST      — the Hetzner VPS's IP or hostname
#   DEPLOY_USER      — SSH user on the VPS (needs Docker permissions there)
#   DEPLOY_SSH_KEY   — private key contents (paste the whole key, not a path)
#   DEPLOY_SSH_PORT  — optional, defaults to 22 if unset
#   DEPLOY_APP_DIR   — absolute path to this repo's checkout on the VPS
# Fill these in below purely as your own local reference for what to paste
# into GitHub — the VPS itself also needs a real .env (this file, filled in
# with real production values) placed at DEPLOY_APP_DIR/.env; deploy.sh does
# not create or manage that file, only reads it.
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_SSH_KEY_PATH=
DEPLOY_SSH_PORT=22
DEPLOY_APP_DIR=
