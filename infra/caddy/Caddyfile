:80 {
	# Caddy resolves `app` fresh per request (unlike nginx, which caches an
	# upstream hostname's resolved IP at startup/reload) — that's what lets a
	# freshly started replica from `docker compose up --scale app=2` start
	# receiving traffic without restarting this proxy. health_uri also takes
	# a replica out of rotation on its own if it stops responding, on top of
	# whatever deploy.sh's own health-check-then-teardown sequence is doing.
	reverse_proxy app:3002 {
		health_uri /health
		health_interval 5s
		health_timeout 3s
	}
}
