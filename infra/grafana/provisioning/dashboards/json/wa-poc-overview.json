{
  "title": "wa-poc overview",
  "uid": "wa-poc-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Log volume",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"wa-poc\"}[$__interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (level >= error)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"wa-poc\"} | json | level >= 50 [$__interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Recent error logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "{service=\"wa-poc\"} | json | level >= 50",
          "refId": "A"
        }
      ]
    }
  ]
}
